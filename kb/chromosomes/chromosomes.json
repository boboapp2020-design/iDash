  {
    "id": "chromo.executive_summary",
    "version": "1.0.0",
    "intent": "5-second answer to the top-ranked decisions",
    "audience": ["executive"],
    "slots": [
      { "slot": "headline_kpis", "gene": "gene.kpi_card_trend", "count": [3, 5], "fill": "Top KPIs by decision rank" },
      { "slot": "hero", "gene_any": ["gene.trend_target_band", "gene.contribution_waterfall"], "count": 1, "fill": "Primary decision visual" },
      { "slot": "alerts", "gene": "gene.alert_strip", "count": [0, 1], "fill_when": "Any KPI breaches target or band" },
      { "slot": "narrative", "gene": "gene.insight_strip", "count": 1, "fill": "Top insight headline with fact citation" }
    ],
    "layout_hint": "kpi-row-then-hero",
    "attentionBudget": 8
  },
