  {
    "id": "kpi.sugar.undetermined_loss",
    "version": "1.0.0",
    "domain": "sugar_factory",
    "name": { "th": "การสูญเสียที่ไม่ทราบสาเหตุ", "en": "Undetermined Loss %" },
